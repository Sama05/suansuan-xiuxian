# 依赖
node_modules/

# 运行时数据（含本地账号与存档，不进仓库）
data/

# 生成物：截图与静态预览页
preview/
testout.txt

# Python 字节码
__pycache__/
*.pyc

# 工具/编辑器
.workbuddy/
.vscode/*
# 但下面这几个是**团队共用**的项目配置：F5 启动、任务面板、UTF-8/终端设置。
# 不跟着仓库走的话，换台机器克隆下来就「跑不起来、还得手搓」，所以显式放行。
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.log
.DS_Store
Thumbs.db

# 本机私有的演示账号（见 tools/_env.py）
tools/_local.json

# 改动前的本地备份目录（.bak-YYYYMMDD / .bak-YYYYMMDDb）
.bak-*/

# 一次性草稿脚本（正式验收脚本是 tools/verify-v38.py，无下划线前缀）
tools/_verify*.py
